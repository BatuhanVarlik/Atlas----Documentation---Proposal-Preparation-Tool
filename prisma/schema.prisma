generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  users    User[]
  projects Project[]
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  password     String
  role         Role    @default(MEMBER)
  departmentId String
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  department      Department @relation(fields: [departmentId], references: [id])
  createdProjects     Project[]              @relation("ProjectCreator")
  createdModules      Module[]               @relation("ModuleCreator")
  reviewedModules     Module[]               @relation("ModuleReviewer")
  resetRequests       PasswordResetRequest[] @relation("ResetRequestUser")
  resolvedResets      PasswordResetRequest[] @relation("ResetRequestResolver")
  moduleRevisions     ModuleRevision[]       @relation("ModuleRevisionCreator")
  createdMilkReceptionModules  MilkReceptionModule[]         @relation("MilkReceptionModuleCreator")
  milkReceptionRevisions       MilkReceptionModuleRevision[] @relation("MilkReceptionModuleRevisionCreator")
  customCatalogItems           CustomCatalogItem[]           @relation("CustomCatalogCreator")
  createdCipModules            CipModule[]                   @relation("CipModuleCreator")
  cipRevisions                 CipModuleRevision[]           @relation("CipModuleRevisionCreator")
}

enum Role {
  ADMIN
  DEPARTMENT_MANAGER
  MEMBER
}

model Project {
  id           String        @id @default(cuid())
  name         String
  customerName String?
  description  String?
  code         String        @unique
  status       ProjectStatus @default(ACTIVE)
  departmentId String
  creatorId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  creator    User       @relation("ProjectCreator", fields: [creatorId], references: [id])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Module {
  id           String       @id @default(cuid())
  name         String
  customerName String?
  projectCode  String?
  standard     Standard
  productType  ProductType
  status       ModuleStatus @default(DRAFT)

  selectedDN            String?
  selectedInnerDiameter Float?
  selectedOuterDiameter Float?

  valveType              ValveType?
  valveControlUnit       ControlUnitType?
  cipReturnValveType     CipReturnValveType?
  waterInletValveType    WaterInletType?
  tankCipInletValveType  TankCipInletValveType?
  tankCipInletDiameter   String?

  // Tank CIP Dönüş Hattı (modül seviyesinde, tüm tanklar için ortak)
  tankCipReturnManifoldExists Boolean @default(false)
  tankCipReturnLineCount      Int     @default(1)
  tankCipReturnPumpModel      String?
  tankCipReturnPumpKw         Float?
  tankCipReturnPumpImpellerSize Float?

  // Fiyatlandırma manuel düzenlemeleri (önizlemeden kaydedilir)
  priceMultiplier Float @default(1)
  priceOverrides  Json?   // { [rowKey]: number } — satır bazında manuel birim net fiyat

  // === Teklif (commercial) bilgileri — yeni teklif şablonu (HEM-PROJECT-NO) için ===
  quotationNo           String?  // örn. HEM-2026-001 (oluşturmada otomatik üretilir)
  customerContactPerson String?  // mektup: "For the Attention of ___"
  deliveryWeeks         Int?     // "Can be delivered within X weeks"
  deliveryPlace         String?  @default("Customer Factory")
  offerValidityDays     Int?     @default(30) // Offer validity + bağlayıcı kabul süresi

  creatorId  String
  reviewerId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  creator      User                @relation("ModuleCreator", fields: [creatorId], references: [id])
  reviewer     User?               @relation("ModuleReviewer", fields: [reviewerId], references: [id])
  valveCluster ValveCluster?
  tanks        Tank[]
  aiReviews    AIReview[]
  documents    GeneratedDocument[]
  activities   ModuleActivity[]
  revisions    ModuleRevision[]
}

model ModuleRevision {
  id             String   @id @default(cuid())
  moduleId       String
  revisionNumber Int                      // 1, 2, 3...
  label          String                   // "RV-01", "RV-02"...
  description    String                   @db.Text
  detectedChanges Json?                   // [{ field, before, after }]
  snapshot       Json                     // full module state
  createdById    String
  createdAt      DateTime @default(now())

  module    Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ModuleRevisionCreator", fields: [createdById], references: [id])

  @@unique([moduleId, revisionNumber])
  @@index([moduleId, createdAt])
}

enum Standard {
  DIN
  SMS
}

enum ProductType {
  HYGIENIC
  ULTRA_HYGIENIC
}

enum ModuleStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  DOCUMENT_GENERATED
  ARCHIVED
  CANCELLED
}

model ValveCluster {
  id       String @id @default(cuid())
  moduleId String @unique

  module         Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  fillingLines   FillingLine[]
  dischargeLines DischargeLine[]
}

model FillingLine {
  id             String  @id @default(cuid())
  valveClusterId String
  name           String
  order          Int
  capacity       Float
  calculatedDiameter Float?
  valveType        ValveType
  valveControlUnit ControlUnitType @default(AS_I)
  connectedTankCount Int           @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  valveCluster ValveCluster @relation(fields: [valveClusterId], references: [id], onDelete: Cascade)
}

model DischargeLine {
  id             String  @id @default(cuid())
  valveClusterId String
  name           String
  order          Int
  capacity       Float
  pressure       Float
  calculatedDiameter     Float?
  valveType              ValveType
  valveControlUnit       ControlUnitType @default(AS_I)
  connectedTankCount     Int             @default(1)
  pumpModel              String?
  pumpKw                 Float?
  pumpImpellerSize       Float?
  hasPressureTransmitter Boolean         @default(false)
  hasFlowMeter           Boolean         @default(false)
  flowMeterDiameter      Float?
  waterInletType         WaterInletType?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  valveCluster ValveCluster @relation(fields: [valveClusterId], references: [id], onDelete: Cascade)
}

enum ValveType {
  SDE44
  D44
  D44SL
  DA44
}

enum ControlUnitType {
  NONE
  AS_I
  DC
}

enum WaterInletType {
  SW_CIP42
  SD42
}

enum CipReturnValveType {
  SW_CIP41
  SD41
}

enum TankCipInletValveType {
  SW43
  SW44
}

model Tank {
  id       String @id @default(cuid())
  moduleId String
  name     String
  order    Int
  volume   Float

  hasLSH Boolean @default(false)
  hasLSM Boolean @default(false)
  hasLSL Boolean @default(false)
  hasTT  Boolean @default(false)
  hasPT  Boolean @default(false)

  samplingValve      SamplingValveType
  hasProximitySwitch Boolean           @default(false)

  hasAgitator      Boolean          @default(false)
  agitatorMotorKw  Float?
  agitatorRpm      Int?
  agitatorPosition AgitatorPosition?

  cipBall                CipBallType
  hasCipInletForAgitator Boolean     @default(false)
  hasCipInletForManhole  Boolean     @default(false)

  hasTankOutletValve     Boolean                 @default(false)
  tankOutletValveType    TankOutletValveType?
  tankOutletValveSubType TankOutletValveSubType?

  manifoldHasCipReturnPump  Boolean @default(false)
  cipReturnPumpModel        String?
  cipReturnPumpKw           Float?
  cipReturnPumpImpellerSize Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

enum SamplingValveType {
  MANUAL
  WITH_ACTUATOR
}

enum AgitatorPosition {
  SIDE
  TOP
}

enum CipBallType {
  STATIC
  ROTARY
}

enum TankOutletValveType {
  MANUAL
  WITH_ACTUATOR
}

enum TankOutletValveSubType {
  BUTTERFLY
  SINGLE_SEAT
  SINGLE_SEAT_TANK
  SW_CIP_TANK
  SD_TANK
  D_TANK
}

model AIReview {
  id          String         @id @default(cuid())
  moduleId    String
  prompt      String         @db.Text
  response    String         @db.Text
  suggestions Json
  status      AIReviewStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

enum AIReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
  PARTIAL
}

model GeneratedDocument {
  id            String   @id @default(cuid())
  moduleId      String
  templateId    String
  filename      String
  filepath      String
  size          Int
  generatedById String
  createdAt     DateTime @default(now())

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  template DocumentTemplate @relation(fields: [templateId], references: [id])
}

model DocumentTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  filename     String
  filepath     String
  placeholders Json
  isActive     Boolean  @default(true)
  moduleType   String   @default("STORAGE")
  createdAt    DateTime @default(now())

  documents              GeneratedDocument[]
  milkReceptionDocuments MilkReceptionGeneratedDocument[]
  cipDocuments           CipGeneratedDocument[]
}

// Kataloğa elle eklenen ürünler (Excel'de karşılığı olmayanlar:
// Milk Clarifier, PHE, W+ pompalar vb.). Fiyatlandırma bunlardan otomatik çeker.
model CustomCatalogItem {
  id          String   @id @default(cuid())
  kind        String                 // MILK_CLARIFIER | PHE | PUMP | OTHER (eşleştirme anahtarı)
  name        String                 // teknik açıklama / model
  standard    String   @default("")  // 'DIN' | 'SMS' | '' (her ikisi)
  size        String?                // ör. "DN50" / "63 SMS (2\")" / pompa modeli
  listPrice   Float
  discount    Float    @default(0)
  createdById String
  createdBy   User     @relation("CustomCatalogCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([kind])
}

model PasswordResetRequest {
  id                 String                     @id @default(cuid())
  userId             String
  user               User                       @relation("ResetRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  hashedNewPassword  String
  status             PasswordResetRequestStatus @default(PENDING)
  requestedAt        DateTime                   @default(now())
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         User?                      @relation("ResetRequestResolver", fields: [resolvedById], references: [id])

  @@index([status, requestedAt])
}

enum PasswordResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ModuleActivity {
  id        String   @id @default(cuid())
  moduleId  String
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

// =====================================================================
// MİLK RECEPTION MODULE (Süt Alım) — Storage modülünden bağımsız yapı
// =====================================================================

model MilkReceptionModule {
  id           String       @id @default(cuid())
  name         String
  customerName String?
  projectCode  String?
  standard     Standard
  valveControlUnit ControlUnitType @default(AS_I)
  status       ModuleStatus @default(DRAFT)

  // Hesaplanan/cache değerler
  selectedDN            String?
  selectedInnerDiameter Float?
  selectedOuterDiameter Float?

  // Tanker CIP (modül başına 1, opsiyonel)
  hasTankerCip              Boolean @default(false)
  tankerCipCapacity         Float?
  tankerCipPressure         Float?
  tankerCipPumpModel        String?
  tankerCipPumpKw           Float?
  tankerCipPumpImpellerSize Float?

  // Fiyatlandırma manuel düzenlemeleri (önizlemeden kaydedilir)
  priceMultiplier Float @default(1)
  priceOverrides  Json?   // { [rowKey]: number } — satır bazında manuel birim net fiyat

  // === Teklif (commercial) bilgileri — yeni teklif şablonu (HEM-PROJECT-NO) için ===
  // Degazör/Sensör adetleri modülden istenmez; context'te kurallardan türetilir.
  quotationNo           String?  // örn. HEM-2026-001 (oluşturmada otomatik üretilir)
  customerContactPerson String?  // mektup: "For the Attention of ___"
  deliveryWeeks         Int?     // "Can be delivered within X weeks"
  deliveryPlace         String?  @default("Customer Factory")
  offerValidityDays     Int?     @default(30) // Offer validity + bağlayıcı kabul süresi

  creatorId  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  creator        User                          @relation("MilkReceptionModuleCreator", fields: [creatorId], references: [id])
  receptionLines MilkReceptionLine[]
  revisions      MilkReceptionModuleRevision[]
  documents      MilkReceptionGeneratedDocument[]
}

model MilkReceptionGeneratedDocument {
  id            String   @id @default(cuid())
  moduleId      String
  templateId    String
  filename      String
  filepath      String
  size          Int
  generatedById String
  createdAt     DateTime @default(now())

  module   MilkReceptionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  template DocumentTemplate    @relation(fields: [templateId], references: [id])
}

model MilkReceptionLine {
  id        String              @id @default(cuid())
  moduleId  String
  module    MilkReceptionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name      String
  order     Int

  capacity  Float
  pressure  Float
  calculatedDiameter Float?     // mm, ham hesap (V=2)

  // Pompa
  pumpModel        String?
  pumpKw           Float?
  pumpImpellerSize Float?

  // Filter Unit
  filterUnitCount   Int               @default(1)
  pressureMeterType PressureMeterType @default(MANOMETER)

  // Milk Clarifier
  hasMilkClarifier         Boolean                   @default(false)
  clarifierBypassValveType ClarifierBypassValveType?

  // PHE (Plate Heat Exchanger)
  hasPhe                       Boolean             @default(false)
  pheCapacity                  Float?
  pheIceWaterTempSensorType    PheTempSensorType?
  pheIceWaterPressureMeterType PressureMeterType?

  // Sampling Valve
  hasSamplingValve  Boolean             @default(false)
  samplingValveType SamplingValveType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PressureMeterType {
  MANOMETER
  PRESSURE_TRANSMITTER
}

enum ClarifierBypassValveType {
  SW44
  SW41
}

enum PheTempSensorType {
  PT100
  THERMOMETER
}

model MilkReceptionModuleRevision {
  id              String   @id @default(cuid())
  moduleId        String
  revisionNumber  Int
  label           String
  description     String   @db.Text
  detectedChanges Json?
  snapshot        Json
  createdById     String
  createdAt       DateTime @default(now())

  module    MilkReceptionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy User                @relation("MilkReceptionModuleRevisionCreator", fields: [createdById], references: [id])

  @@unique([moduleId, revisionNumber])
  @@index([moduleId, createdAt])
}

// =====================================================================
// CIP MODULE (Clean-in-Place) — Storage/MilkReception'dan bağımsız yapı
// =====================================================================

model CipModule {
  id           String          @id @default(cuid())
  name         String
  customerName String?
  projectCode  String?
  standard     Standard
  valveControlUnit ControlUnitType @default(NONE)
  systemType   CipSystemType
  status       ModuleStatus    @default(DRAFT)

  // Tank-ortak seçimler (tüm tanklar için)
  samplingValve   CipSamplingValve @default(NONE)
  hasManholeSwitch Boolean         @default(false)

  // Hesaplanan/cache değerler
  selectedDN            String?
  selectedInnerDiameter Float?
  selectedOuterDiameter Float?

  // Fiyatlandırma manuel düzenlemeleri (önizlemeden kaydedilir)
  priceMultiplier Float @default(1)
  priceOverrides  Json?

  // === Teklif (commercial) bilgileri — HEM-PROJECT-NO şablonu için ===
  quotationNo           String?
  customerContactPerson String?
  deliveryWeeks         Int?
  deliveryPlace         String?  @default("Customer Factory")
  offerValidityDays     Int?     @default(30)

  creatorId  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  creator   User                   @relation("CipModuleCreator", fields: [creatorId], references: [id])
  tanks     CipTank[]
  lines     CipLine[]
  revisions CipModuleRevision[]
  documents CipGeneratedDocument[]
}

model CipTank {
  id       String      @id @default(cuid())
  moduleId String
  tankType CipTankType
  order    Int

  capacity   Float
  material   TankMaterial
  insulation TankInsulation

  // Sensörler
  hasLSH            Boolean @default(false)
  hasLSL            Boolean @default(false)
  hasExternalSensor Boolean @default(false)

  // Pressure transmitter (Fresh Water'da kullanılmaz)
  hasPressureTransmitter Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module CipModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, tankType])
}

model CipLine {
  id       String      @id @default(cuid())
  moduleId String
  lineKind CipLineKind
  name     String
  order    Int

  capacity Float // m³/h
  pressure Float // bar
  calculatedDiameter Float? // mm, ham hesap

  pumpModel        String?
  pumpKw           Float?
  pumpImpellerSize Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module CipModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model CipGeneratedDocument {
  id            String   @id @default(cuid())
  moduleId      String
  templateId    String
  filename      String
  filepath      String
  size          Int
  generatedById String
  createdAt     DateTime @default(now())

  module   CipModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  template DocumentTemplate @relation(fields: [templateId], references: [id])
}

model CipModuleRevision {
  id              String   @id @default(cuid())
  moduleId        String
  revisionNumber  Int
  label           String
  description     String   @db.Text
  detectedChanges Json?
  snapshot        Json
  createdById     String
  createdAt       DateTime @default(now())

  module    CipModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CipModuleRevisionCreator", fields: [createdById], references: [id])

  @@unique([moduleId, revisionNumber])
  @@index([moduleId, createdAt])
}

enum CipSystemType {
  FORWARD
  CIRCULATED
}

enum CipTankType {
  CAUSTIC
  ACID
  HOT_WATER
  RECOVERY
  FRESH_WATER
}

enum TankMaterial {
  AISI_304
  AISI_316
}

enum TankInsulation {
  INSULATED
  UNINSULATED
}

enum CipSamplingValve {
  NONE
  MANUAL
  WITH_ACTUATOR
}

enum CipLineKind {
  DISCHARGE
  RETURN
}
